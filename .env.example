# Database Configuration
DB_URL=jdbc:sqlserver://localhost:8386;databaseName=travel_social_network_v2;encrypt=true;trustServerCertificate=true;
DB_USERNAME=sa
DB_PASSWORD=your-database-password
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION_SECONDS=3600

# Cloudinary Configuration
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# OAuth2 Google Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 Facebook Configuration
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB Configuration (Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=travel_social_network_chat

# API Configuration
API_BASE_URL=/api/v2
API_CLIENT_URL=http://localhost:5173

# Google OAuth API
GOOGLE_OAUTH_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo

# File Upload Configuration
MAX_FILE_SIZE=200MB
MAX_REQUEST_SIZE=200MB

# Logging Configuration
LOG_LEVEL_SPRINGDOC=DEBUG
LOG_LEVEL_SPRING_WEB=DEBUG
LOG_LEVEL_SPRING_SECURITY=TRACE

# Test Environment Variables
TEST_DB_URL=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
TEST_DB_DRIVER=org.h2.Driver
TEST_DB_USERNAME=sa
TEST_DB_PASSWORD=
TEST_API_BASE_URL=/api/v2
TEST_API_CLIENT_URL=http://localhost:3000
TEST_JWT_SECRET=test-secret-key-for-testing-only
TEST_JWT_EXPIRATION_SECONDS=3600
TEST_MAIL_HOST=localhost
TEST_MAIL_PORT=587
TEST_MAIL_USERNAME=test@example.com
TEST_MAIL_PASSWORD=test
TEST_LOG_LEVEL_SPRING_WEB=DEBUG
TEST_LOG_LEVEL_HIBERNATE_SQL=DEBUG
TEST_LOG_LEVEL_HIBERNATE_BINDER=TRACE
TEST_LOG_LEVEL_SPRING_SECURITY=DEBUG
